# Apple Support AI — configuration template.
# Copy to `.env` and adjust. Every value has a code default; only
# APPLE_SUPPORT_AUTHOR_ID has no default and MUST be set explicitly
# (discover it with `python scripts/find_author_ids.py` — never guess it).

# --- Required ---------------------------------------------------------------
# The outbound author_id of the Apple support account in twcs.csv.
APPLE_SUPPORT_AUTHOR_ID=AppleSupport

# --- Phase 1: data pipeline -------------------------------------------------
# RAW_DATA_PATH=data/raw/twcs.csv
# PROCESSED_DIR=data/processed
# RANDOM_SEED=42
# CHUNK_SIZE=200000
# CLOSURE_MAX_PASSES=6                   # reference full-scale run used 12

# --- Phase 2+: intent classification / retrieval thresholds -----------------
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# INTENT_CONFIDENCE_THRESHOLD=0.60
# RETRIEVAL_THRESHOLD=0.65
# TOP_K=5

# --- Phase 5+: response generation (never logged by src/config.py) ---------
# LLM_MODEL=
# LLM_API_KEY=
